# App
SNOW_PORTAL_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SESSION_TIMEOUT_HOURS=12

# Postgres
POSTGRES_USER=snow_portal
POSTGRES_PASSWORD=snow_portal
POSTGRES_DB=snow_portal
DATABASE_URL=postgresql://snow_portal:snow_portal@postgres:5432/snow_portal

# Streamlit / Web
STREAMLIT_SERVER_PORT=8501

# Porta da API no host (8000 costuma estar ocupada por outros projetos)
API_PORT=8010

# Browser OAuth
# Padrão (local): SNOWFLAKE$LOCAL_APPLICATION + PKCE, que só aceita redirect em localhost.
OAUTH_REDIRECT_URI=http://127.0.0.1:8010
PORTAL_PUBLIC_URL=http://localhost:8501
# Fora da máquina local (ex.: Azure): crie uma security integration OAuth CUSTOM no
# Snowflake (SQL no README, seção "OAuth fora do localhost") e preencha os três:
#   OAUTH_REDIRECT_URI=https://portal.example.com/api/oauth/callback   (igual ao da integração)
#   PORTAL_PUBLIC_URL=https://portal.example.com
#   OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET = saída de SYSTEM$SHOW_OAUTH_CLIENT_SECRETS
# Vazios = LOCAL_APPLICATION. Tokens já emitidos continuam renovando pelo client que os emitiu.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Pasta do host que espelha connection_tokens em JSON (valor sempre criptografado).
# Montada no container api em /app/tokens. Sem valor, usa ./tokens (no .gitignore).
TOKENS_HOST_DIR=/caminho/absoluto/para/tokens
